# ==============================================================================
# HMIS Production Environment Template
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0

# Redis Connection URL (For token blocklisting & background workers)
REDIS_URL=redis://redis:6379/0

# JWT Security Secrets (Use high-entropy 64-char strings)
JWT_SECRET=replace_with_a_super_strong_production_secret_key_2026
JWT_REFRESH_SECRET=replace_with_a_super_strong_production_refresh_secret_2026
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7

# Inventory Sync Bridge Connection (Central Inventory Platform)
INVENTORY_API_BASE_URL=https://inventory.agpkacademy.in
INVENTORY_BRIDGE_API_KEY=test_bridge_api_key_123456

# Application Server Profile Settings
DEBUG=false
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8070
ALLOWED_ORIGINS=https://technulhims.technula.com,http://technulhims.technula.com,http://localhost:3000,http://localhost:5173,http://localhost:8070,http://127.0.0.1:8070

# S3-Compatible File Storage (Cloudflare R2 or AWS S3)
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key
S3_BUCKET_NAME=your_r2_bucket_name
S3_REGION_NAME=us-east-1
R2_PUBLIC_URL_PREFIX=https://pub-<id>.r2.dev

# ABDM Gateway / ABHA Sandbox Configuration
ABDM_CLIENT_ID=your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret
ABDM_GATEWAY_URL=https://dev.abdm.gov.in

# WhatsApp Messaging Gateway Credentials
WHATSAPP_API_URL=https://api.whatsapp.com/v1/messages
WHATSAPP_API_TOKEN=your_whatsapp_token_here

# Expo Push Notifications Access Key
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# PayU Checkout Credentials
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt
PAYU_ENV=live
PAYU_SUCCESS_URL=https://technulhims.technula.com/payment/success
PAYU_FAILURE_URL=https://technulhims.technula.com/payment/failure

# Telemedicine Jitsi Host Domain
JITSI_DOMAIN=meet.jit.si

# Google Gemini API Key for clinical summaries
GEMINI_API_KEY=your_gemini_api_key_here

# DMS Bridge Integration Settings
DMS_API_BASE_URL=http://localhost:8000
DMS_BRIDGE_API_KEY=change-me-long-random-secret
DMS_WEBHOOK_SECRET=change-me-webhook-secret
DMS_INTEGRATION_ENABLED=true
DMS_REQUEST_TIMEOUT_SECONDS=15

# MetaReach SMS Configuration
METAREACH_ENABLED=true
METAREACH_API_BASE_URL=https://sms.metareach.in/vb/apikey.php
METAREACH_API_KEY=your_metareach_api_key
METAREACH_TEMPLATE_ID=1707177071739047190
METAREACH_OTP_ROUTE=otp
METAREACH_SENDER_ID=AGPKAC

# Development helpers (Disabled in production)
DEV_FAKE_SMS=false
DEV_OTP_BYPASS=false
